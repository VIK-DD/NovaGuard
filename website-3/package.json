{
  "name": "novaguard-website",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "sync-updates": "node scripts/sync-updates-archive.mjs",
    "build": "node scripts/sync-updates-archive.mjs && astro check && astro build && node scripts/soft-launch.mjs",
    "build:launch": "node scripts/sync-updates-archive.mjs && astro check && astro build",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^6.0.2",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-router": "^1.112.0",
    "astro": "^7.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.11.2",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }

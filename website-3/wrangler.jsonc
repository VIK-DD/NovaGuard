{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaguard",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-19",
  "preview_urls": false,
  // Keep enough production telemetry to diagnose edge/API failures without
  // retaining every static-asset request. Traces are automatic once enabled.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  // Astro builds to ./dist (Next.js used ./out). run_worker_first lets the
  // worker enforce the password gate before any static asset is served.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}

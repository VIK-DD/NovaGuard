{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaguard",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-19",
  "preview_urls": false,
  // Both are required. GATE_SIGNING_KEY was optional so an existing install
  // would not start failing at deploy time - but "optional" meant the worker
  // fell back to signing cookies with AUTH_PASSWORD, which is the whole
  // weakness the key exists to remove, and it did so behind a log line at 25%
  // sampling. A deploy that fails loudly with one command to fix it is better
  // than a deploy that succeeds and is quietly weaker than the code claims.
  //   wrangler secret put GATE_SIGNING_KEY     (32+ random bytes)
  "secrets": {
    "required": ["AUTH_PASSWORD", "GATE_SIGNING_KEY"]
  },
  // Ten password submissions per minute in each Cloudflare location while the
  // temporary launch gate is active. The endpoint retires automatically at
  // public launch; leaving the dormant binding configured is harmless.
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026082601",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    // Its own namespace rather than sharing the login one. /api/preview is the
    // second unauthenticated door, and each submission is proxied to the bot's
    // API - so it needs a budget, but a shared budget would mean traffic at
    // one door closes the other. That exact bug was fixed on the API side for
    // this same pair of endpoints.
    {
      "name": "PREVIEW_RATE_LIMITER",
      "namespace_id": "2026083101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  // Keep enough production telemetry to diagnose edge/API failures without
  // retaining every static-asset request. Traces are automatic once enabled.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.25,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  // Astro builds to ./dist (Next.js used ./out). run_worker_first lets the
  // Worker enforce the exact launch instant and maintenance state before any
  // static page is served.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}

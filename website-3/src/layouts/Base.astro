---
import "../styles/global.css";
import hankenLatin from "@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2";
import outfitLatin from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2";
interface Props {
  title: string;
  description?: string;
  preconnectApi?: boolean;
}
const {
  title,
  description = "NovaGuard — the friendly guardian for your Discord community.",
  preconnectApi = false,
} = Astro.props;
const apiBase = import.meta.env.PUBLIC_API_BASE;
let apiOrigin: string | undefined;
try {
  apiOrigin = apiBase ? new URL(apiBase).origin : undefined;
} catch {
  apiOrigin = undefined;
}
// Dev-only: when PUBLIC_MOCK_API=1, load the in-memory API mock from <head> so
// its window.fetch patch is in place before any body script fires a request.
const mockEnabled = import.meta.env.DEV && import.meta.env.PUBLIC_MOCK_API === "1";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0c" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/favicon.png" />
    <link rel="icon" type="image/png" href="/assets/novaguard-icon-96.png" />
    <link rel="apple-touch-icon" href="/assets/novaguard-icon-96.png" />
    <link rel="preload" href={hankenLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={outfitLatin} as="font" type="font/woff2" crossorigin />
    <style
      is:global
      set:html={`
        @font-face {
          font-family: "Hanken Grotesk Variable";
          font-style: normal;
          font-weight: 100 900;
          font-display: swap;
          src: url("${hankenLatin}") format("woff2-variations");
        }

        @font-face {
          font-family: "Outfit Variable";
          font-style: normal;
          font-weight: 100 900;
          font-display: swap;
          src: url("${outfitLatin}") format("woff2-variations");
        }
      `}
    />
    {preconnectApi && apiOrigin && <link rel="preconnect" href={apiOrigin} crossorigin />}
    <script is:inline>
      // Dark-first: apply the stored/preferred theme before first paint (no flash).
      (() => {
        const stored = localStorage.getItem("ng-theme");
        const light = stored
          ? stored === "light"
          : matchMedia("(prefers-color-scheme: light)").matches;
        const root = document.documentElement;
        root.dataset.theme = light ? "light" : "dark";
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", light ? "#fbfbfe" : "#0a0a0c");

        // One shared read of the device budget, taken before first paint so CSS
        // can gate on it (see `[data-low-power]` in global.css) and the theme
        // wipe can pick its timings without repeating the heuristic.
        const cores = navigator.hardwareConcurrency;
        const memory = navigator.deviceMemory;
        if ((cores > 0 && cores <= 4) || (memory !== undefined && memory <= 4)) {
          root.dataset.lowPower = "";
        }
      })();
    </script>
    <script is:inline>
      // Public stats and the status page share one request in memory. Cloudflare
      // already provides stale edge fallback, so the browser does not need to
      // persist operational data in localStorage or sessionStorage.
      const getNgStatusUrl = () => `/api/status-snapshot?t=${Math.floor(Date.now() / 30000)}`;
      window.__ngGetStatusSnapshot = (refresh = false) => {
        if (refresh) window.__ngStatusRequest = null;
        if (!window.__ngStatusRequest) {
          const options = {
            headers: { Accept: "application/json" },
            keepalive: true,
          };
          if (typeof AbortSignal.timeout === "function") {
            options.signal = AbortSignal.timeout(4000);
          }
          window.__ngStatusRequest = fetch(getNgStatusUrl(), { ...options, cache: "no-store" })
            .then((response) => {
              if (!response.ok) throw new Error(`Status request failed: ${response.status}`);
              return response.json();
            })
            .catch((error) => {
              window.__ngStatusRequest = null;
              throw error;
            });
        }
        return window.__ngStatusRequest;
      };
      window.__ngGetLiveStats = () =>
        window.__ngGetStatusSnapshot().then((snapshot) => snapshot.stats);
    </script>
    {
      mockEnabled && (
        <>
          <script
            is:inline
            set:html={`(() => {
  if (window.__ngMockReady) return;
  window.__ngMockReady = new Promise((r) => (window.__ngMockResolve = r));
  const real = window.fetch.bind(window);
  window.fetch = (input, init) => {
    const url = typeof input === "string" ? input : (input && (input.url || input.href)) || "";
    if (!url.includes("/api/v1")) return real(input, init);
    return window.__ngMockReady.then((h) => h(input, init, real));
  };
})();`}
          />
          <script>import "../lib/api/mock";</script>
        </>
      )
    }
  </head>
  <body class="min-h-screen bg-background font-sans text-ink">
    <slot />
  </body>
</html>

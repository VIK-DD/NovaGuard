---
import Icon from "./Icon.astro";
---

<div data-theme-curtain class="theme-curtain" aria-hidden="true">
  <span class="theme-curtain-edge"></span>
</div>
<div>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-5 py-2 text-[11px] tracking-[0.13em] text-ink-faint uppercase sm:gap-4 sm:px-6 sm:tracking-[0.16em]"
  >
    <time data-masthead-date class="max-w-[58%] truncate sm:max-w-none"></time>
    <button
      type="button"
      data-theme-toggle
      aria-label="Switch to light mode"
      class="ng-pressable flex min-h-11 w-28 cursor-pointer items-center justify-end gap-1.5 transition-colors hover:text-ink"
    >
      <span data-theme-day-label class="flex shrink-0 items-center gap-1.5">
        <Icon name="sun" size={13} /> Day edition
      </span>
      <span data-theme-night-label class="hidden shrink-0 items-center gap-1.5">
        <Icon name="moon" size={13} /> Night edition
      </span>
    </button>
  </div>
</div>
<script>
  function init() {
    const dateEl = document.querySelector("[data-masthead-date]");
    if (dateEl) {
      dateEl.textContent = new Intl.DateTimeFormat("en", {
        weekday: "long",
        month: "long",
        day: "numeric",
        year: "numeric",
      }).format(new Date());
    }

    const KEY = "ng-theme";
    const root = document.documentElement;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    // Base.astro takes one reading of the device budget before first paint;
    // reuse that flag rather than repeating the heuristic here.
    const lowPower = !reduce && root.hasAttribute("data-low-power");
    const simpleMotion = reduce || lowPower;
    const curtain = document.querySelector<HTMLElement>("[data-theme-curtain]");
    // Weighted towards deceleration: the sweep leaves briskly and spends most
    // of its time gliding to a stop. Over a long wipe that reads smoother than
    // a symmetric curve, which appears to hang at mid-screen.
    const wipeEasing = "cubic-bezier(0.4, 0, 0.15, 1)";
    let themeTransitioning = false;

    const setTheme = (light: boolean) => {
      root.dataset.theme = light ? "light" : "dark";
      localStorage.setItem(KEY, light ? "light" : "dark");
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute("content", light ? "#fbfbfe" : "#0a0a0c");
      document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((button) => {
        button.setAttribute("aria-label", light ? "Switch to dark mode" : "Switch to light mode");
      });
    };

    // Resolve once the browser has committed a fresh paint. Two frames guarantee
    // the style recalc is on screen; the extra dwell gives low-powered GPUs room
    // to finish the full-page theme repaint while the curtain still hides it, so
    // the reveal is never a half-painted flash. Zero cost under reduced-motion.
    const paintDwell = (ms: number) =>
      new Promise<void>((resolve) =>
        requestAnimationFrame(() =>
          requestAnimationFrame(() => (ms > 0 ? setTimeout(resolve, ms) : resolve())),
        ),
      );

    const transitionTheme = async (light: boolean, button: HTMLElement) => {
      themeTransitioning = true;
      button.setAttribute("aria-busy", "true");
      // Keep the pointer/hand cursor visible across the whole sweep (global.css).
      root.setAttribute("data-theme-switching", "");
      let incoming: HTMLElement | null = null;
      let exitAnimation: Animation | undefined;
      let enterAnimation: Animation | undefined;
      let curtainIn: Animation | undefined;
      let curtainOut: Animation | undefined;
      try {
        if (curtain) {
          // Promote to its own layer only for the duration of the wipe, then
          // release it in the finally block — no permanent full-screen layer.
          // Render it only for the sweep; see the note on `.theme-curtain`.
          curtain.style.setProperty("display", "block");
          curtain.style.setProperty("will-change", "transform");
          curtain.style.setProperty("--curtain-background", light ? "#fbfbfe" : "#0a0a0c");
          curtain.style.setProperty("--curtain-accent", light ? "#d4660c" : "#f37f2c");
          curtainIn = curtain.animate(
            [
              { transform: "translate3d(101%, 0, 0)", opacity: 1 },
              { transform: "translate3d(0, 0, 0)", opacity: 1 },
            ],
            {
              // One duration for every device that animates. The old split gave
              // desktops the shorter sweep, which is exactly why it read as rushed
              // next to the phone.
              duration: reduce ? 260 : 820,
              easing: wipeEasing,
              fill: "both",
            },
          );
        }

        const outgoing = button.querySelector<HTMLElement>(
          light ? "[data-theme-day-label]" : "[data-theme-night-label]",
        );
        const exitFrames = simpleMotion
          ? [{ opacity: 1 }, { opacity: 0 }]
          : [
              { opacity: 1, transform: "translate3d(0, 0, 0) scale(1) rotate(0deg)" },
              {
                opacity: 0,
                transform: "translate3d(0, -4px, 0) scale(0.96) rotate(-3deg)",
              },
            ];
        exitAnimation = outgoing?.animate(exitFrames, {
          duration: reduce ? 130 : lowPower ? 200 : 280,
          easing: "cubic-bezier(0.4, 0, 0.6, 1)",
          fill: "forwards",
        });
        await Promise.all([
          curtainIn?.finished.catch(() => {}),
          exitAnimation?.finished.catch(() => {}),
        ]);

        incoming = button.querySelector<HTMLElement>(
          light ? "[data-theme-night-label]" : "[data-theme-day-label]",
        );
        incoming?.style.setProperty("opacity", "0");
        if (!simpleMotion) {
          incoming?.style.setProperty(
            "transform",
            "translate3d(0, 4px, 0) scale(0.94) rotate(3deg)",
          );
        }
        setTheme(light);
        await paintDwell(reduce ? 0 : 140);

        if (curtain) {
          curtainOut = curtain.animate(
            [
              { transform: "translate3d(0, 0, 0)", opacity: 1 },
              { transform: "translate3d(-101%, 0, 0)", opacity: 1 },
            ],
            {
              duration: reduce ? 280 : 920,
              easing: wipeEasing,
              fill: "both",
            },
          );
        }

        const enterFrames = simpleMotion
          ? [{ opacity: 0 }, { opacity: 1 }]
          : [
              {
                opacity: 0,
                transform: "translate3d(0, 4px, 0) scale(0.94) rotate(3deg)",
              },
              { opacity: 1, transform: "translate3d(0, 0, 0) scale(1) rotate(0deg)" },
            ];
        enterAnimation = incoming?.animate(enterFrames, {
          duration: reduce ? 190 : lowPower ? 340 : 500,
          easing: "cubic-bezier(0.16, 1, 0.3, 1)",
          fill: "both",
        });
        await Promise.all([
          curtainOut?.finished.catch(() => {}),
          enterAnimation?.finished.catch(() => {}),
        ]);
      } finally {
        exitAnimation?.cancel();
        enterAnimation?.cancel();
        curtainIn?.cancel();
        curtainOut?.cancel();
        incoming?.style.removeProperty("opacity");
        incoming?.style.removeProperty("transform");
        if (curtain) {
          curtain.style.removeProperty("--curtain-background");
          curtain.style.removeProperty("--curtain-accent");
          curtain.style.removeProperty("will-change");
          curtain.style.removeProperty("display");
        }
        button.removeAttribute("aria-busy");
        root.removeAttribute("data-theme-switching");
        themeTransitioning = false;
      }
    };

    // Keep the feedback on the source control. Full-page transitions expose the
    // theme repaint as dropped frames on high-density MacBook displays.
    document.querySelectorAll<HTMLElement>("[data-theme-toggle]").forEach((btn) => {
      btn.setAttribute(
        "aria-label",
        root.dataset.theme === "light" ? "Switch to dark mode" : "Switch to light mode",
      );
      btn.addEventListener("click", () => {
        if (themeTransitioning) return;
        const light = root.dataset.theme !== "light";
        void transitionTheme(light, btn);
      });
    });
  }

  init();
</script>

<style>
  .theme-curtain {
    /* Not rendered until a wipe runs. Left in the tree it was a viewport-sized,
       fully opaque, 3D-transformed fixed element, which browsers keep as a
       permanent compositor layer — real memory bandwidth on a weak GPU, held for
       an animation that only happens on click. The script displays it for the
       duration of the sweep and hides it again in its finally block. */
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: hidden;
    pointer-events: none;
    background: var(--curtain-background, #0a0a0c);
    opacity: 1;
    transform: translate3d(101%, 0, 0);
    backface-visibility: hidden;
    contain: strict;
  }

  .theme-curtain-edge {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 2px;
    background: var(--curtain-accent, #f37f2c);
    opacity: 0.82;
  }
</style>

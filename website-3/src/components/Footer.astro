---
import { LEGAL_COPYRIGHT_START_YEAR } from "../data/legal";

// Derived at build time, not hardcoded: the site rebuilds hourly, so the
// closing year stays right without anyone remembering it every January.
const currentYear = new Date().getFullYear();
const copyrightYears =
  currentYear > LEGAL_COPYRIGHT_START_YEAR
    ? `${LEGAL_COPYRIGHT_START_YEAR}–${currentYear}`
    : `${LEGAL_COPYRIGHT_START_YEAR}`;
---

<footer data-site-footer class="border-t border-line bg-bg-subtle">
  <div
    class="mx-auto grid max-w-6xl gap-12 px-5 py-11 text-sm sm:px-6 sm:py-14 lg:grid-cols-[1fr_auto]"
  >
    <div>
      <p class="font-display text-lg font-semibold">NovaGuard</p>
      <p class="mt-3 text-xs tracking-wide text-ink-faint">
        &copy; {copyrightYears} VIK-DD &middot; Developed under the VIK &amp; CloudMedia names
      </p>
    </div>
    <div class="grid grid-cols-2 gap-8 sm:gap-12 lg:min-w-96">
      <nav aria-label="Product" class="grid content-start gap-3 text-ink-muted">
        <p class="mb-1 text-xs tracking-[0.18em] text-ink-faint uppercase">Product</p>
        <a href="/commands" class="transition-colors hover:text-ink">Commands</a>
        <a href="/setup" class="transition-colors hover:text-ink">Setup guide</a>
        <a href="/updates" class="transition-colors hover:text-ink">Updates</a>
        <a href="/status" class="transition-colors hover:text-ink">Service status</a>
      </nav>
      <nav aria-label="Legal" class="grid content-start gap-3 text-ink-muted">
        <p class="mb-1 text-xs tracking-[0.18em] text-ink-faint uppercase">Legal</p>
        <a href="/privacy" class="transition-colors hover:text-ink">Privacy &amp; cookies</a>
        <a href="/server-admin-notice" class="transition-colors hover:text-ink">Server admin notice</a>
        <a href="/terms" class="transition-colors hover:text-ink">Terms</a>
      </nav>
    </div>
  </div>
</footer>

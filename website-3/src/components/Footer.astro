---
import { LEGAL_COPYRIGHT_START_YEAR } from "../data/legal";
import Icon from "./Icon.astro";

// Derived at build time, not hardcoded: the site rebuilds hourly, so the
// closing year stays right without anyone remembering it every January.
const currentYear = new Date().getFullYear();
const copyrightYears =
  currentYear > LEGAL_COPYRIGHT_START_YEAR
    ? `${LEGAL_COPYRIGHT_START_YEAR}–${currentYear}`
    : `${LEGAL_COPYRIGHT_START_YEAR}`;
---

<footer data-site-footer class="border-t border-line bg-bg-subtle">
  <div
    class="mx-auto grid max-w-6xl gap-12 px-5 py-11 text-sm sm:px-6 sm:py-14 lg:grid-cols-[minmax(0,1.2fr)_auto] lg:gap-20"
  >
    <div class="flex max-w-md flex-col lg:min-h-60">
      <div class="flex items-center gap-3.5">
        <img
          src="/assets/novaguard-icon-96.png"
          alt=""
          width="48"
          height="48"
          loading="lazy"
          decoding="async"
          class="size-12 shrink-0 drop-shadow-[0_8px_18px_hsl(var(--primary)/0.12)]"
        />
        <p class="font-display text-xl font-semibold tracking-[-0.01em] text-ink">NovaGuard</p>
      </div>

      <p class="mt-4 max-w-sm text-sm leading-relaxed text-ink-muted">
        Powerful Discord moderation and utilities for calm, reliable server management. Set up what
        your community needs and leave the rest out.
      </p>

      <nav aria-label="Community" class="mt-5 flex flex-wrap items-center gap-2.5">
        <a
          href="https://discord.gg/CbDy3GyhWm"
          target="_blank"
          rel="noreferrer"
          aria-label="Join the NovaGuard Discord server (opens in a new tab)"
          class="footer-social ng-pressable inline-flex min-h-10 items-center gap-2 rounded-[6px] border border-line px-3 text-ink-muted"
        >
          <svg viewBox="0 0 24 24" class="size-[18px]" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52c.08.1.15.19.21.29a18.3 18.3 0 0 0-5.49 0c.07-.1.14-.2.21-.29a19.7 19.7 0 0 0-4.88 1.52C.53 9.05-.32 13.58.11 18.06a19.9 19.9 0 0 0 5.99 3.03c.49-.67.93-1.37 1.31-2.09a12.8 12.8 0 0 1-2.06-.99l.51-.39a13.2 13.2 0 0 0 12.24 0l.51.39c-.65.39-1.34.72-2.06.99.38.72.82 1.42 1.31 2.09a19.9 19.9 0 0 0 5.99-3.03c.5-5.18-.85-9.67-3.55-13.66ZM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42s.96-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42Zm7.97 0c-1.18 0-2.16-1.09-2.16-2.42s.96-2.42 2.16-2.42c1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42Z"
            />
          </svg>
          <span>Discord</span>
        </a>
        <a
          href="https://github.com/VIK-DD/NovaGuard"
          target="_blank"
          rel="noreferrer"
          aria-label="View NovaGuard on GitHub (opens in a new tab)"
          class="footer-social ng-pressable inline-flex min-h-10 items-center gap-2 rounded-[6px] border border-line px-3 text-ink-muted"
        >
          <Icon name="github" size={18} />
          <span>GitHub</span>
        </a>
      </nav>

      <p class="mt-7 text-xs leading-relaxed tracking-wide text-ink-faint lg:mt-auto lg:pt-8">
        &copy; {copyrightYears} VIK-DD &middot; Developed under the VIK &amp; CloudMedia names
      </p>
    </div>
    <div class="grid grid-cols-2 gap-8 sm:gap-12 lg:min-w-96">
      <nav aria-label="Product" class="grid content-start gap-3 text-ink-muted">
        <p class="mb-1 text-xs tracking-[0.18em] text-ink-faint uppercase">Product</p>
        <a href="/commands" class="transition-colors hover:text-ink">Commands</a>
        <a href="/setup" class="transition-colors hover:text-ink">Setup guide</a>
        <a href="/updates" class="transition-colors hover:text-ink">Updates</a>
        <a href="/status" class="transition-colors hover:text-ink">Service status</a>
      </nav>
      <nav aria-label="Legal" class="grid content-start gap-3 text-ink-muted">
        <p class="mb-1 text-xs tracking-[0.18em] text-ink-faint uppercase">Legal</p>
        <a href="/privacy" class="transition-colors hover:text-ink">Privacy &amp; cookies</a>
        <a href="/server-admin-notice" class="transition-colors hover:text-ink">Server admin notice</a>
        <a href="/terms" class="transition-colors hover:text-ink">Terms</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer-social {
    transition:
      color 160ms ease,
      border-color 160ms ease,
      background-color 160ms ease,
      transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .footer-social:hover {
      border-color: hsl(var(--border-strong));
      background: hsl(var(--card));
      color: hsl(var(--foreground));
      transform: translateY(-1px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-social {
      transition: none;
    }
  }
</style>

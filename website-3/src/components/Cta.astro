---
---

<section data-perf-section class="mx-auto max-w-6xl px-5 py-14 sm:px-6 sm:py-20">
  <div data-reveal class="grid items-center gap-8 sm:grid-cols-[1fr_auto]">
    <h2 class="font-display text-3xl leading-tight font-semibold text-balance sm:text-4xl">
      Give your community its <span class="text-primary">guardian</span>.
    </h2>
    <div class="flex flex-col items-stretch gap-2 sm:relative sm:items-end">
      <a
        href="/dashboard"
        data-invite
        class="ng-pressable flex min-h-11 items-center justify-center rounded-[6px] bg-primary px-6 py-3 font-medium text-primary-ink transition-colors hover:bg-primary/90"
      >
        Add to Discord
      </a>
      <!-- From `sm` up the caption hangs below the button instead of sitting in
           the flex flow, so the column is exactly as tall as the button and the
           grid's `items-center` lines the button up with the heading. -->
      <p
        class="text-xs text-ink-faint sm:absolute sm:top-full sm:right-0 sm:mt-2 sm:whitespace-nowrap"
      >
        Free · Open source · Yours to host
      </p>
    </div>
  </div>
</section>

---
import { publicInviteUrl } from "../lib/publicUrls";

const inviteHref = publicInviteUrl();
---

<section data-perf-section class="mx-auto max-w-6xl px-5 py-20 sm:px-6 sm:py-28">
  <div data-reveal class="mx-auto flex max-w-2xl flex-col items-center text-center">
    <p class="font-mono text-xs tracking-[0.14em] text-primary uppercase">Get started</p>
    <h2 class="mt-4 font-display text-3xl leading-tight font-semibold text-balance sm:text-4xl">
      Give your community its <span class="text-primary">guardian</span>.
    </h2>
    <a
      href={inviteHref}
      class="ng-pressable mt-8 flex min-h-11 w-full items-center justify-center rounded-[6px] bg-primary px-8 py-3.5 font-medium text-primary-ink transition-colors hover:bg-primary/90 sm:w-auto"
    >
      Add to Discord
    </a>
    <p class="mt-3 text-xs text-ink-faint">Free · Open source · Yours to host</p>
  </div>
</section>

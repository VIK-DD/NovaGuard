---
import Masthead from "./Masthead.astro";
import Icon from "./Icon.astro";
import { publicInviteUrl } from "../lib/publicUrls";

const links = [
  { href: "/commands", label: "Commands" },
  { href: "/setup", label: "Setup" },
  { href: "/updates", label: "Updates" },
  { href: "/status", label: "Status" },
  { href: "/dashboard/", label: "Dashboard" },
];
const inviteHref = publicInviteUrl();
---

<Masthead />
<header data-nav class="relative sticky top-0 z-30 border-b border-line bg-background">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6 sm:py-3">
    <a href="/home/" class="flex items-center gap-2.5" aria-label="NovaGuard home">
      <img
        src="/assets/novaguard-icon-96.png"
        alt=""
        width="32"
        height="32"
        class="h-8 w-8"
      />
      <span class="font-display text-base font-semibold tracking-tight sm:text-lg">NovaGuard</span>
    </a>
    <div class="flex items-center gap-2 sm:gap-6">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="hidden text-sm text-ink-muted transition-colors hover:text-ink sm:inline-flex sm:h-9 sm:items-center sm:text-[13px]"
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={inviteHref}
        class="ng-pressable inline-flex h-11 shrink-0 items-center justify-center rounded-[6px] bg-primary px-3 py-1.5 text-[13px] font-medium whitespace-nowrap text-primary-ink transition-colors hover:bg-primary/90 max-[359px]:hidden sm:h-9 sm:px-3.5"
      >
        Add to Discord
      </a>
      <button
        id="nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
        class="ng-pressable grid h-11 w-11 place-items-center rounded-[6px] border border-line text-ink transition-colors hover:border-line-strong sm:hidden"
      >
        <span class="icon-menu"><Icon name="menu" size={18} /></span>
        <span class="icon-close"><Icon name="x" size={18} /></span>
      </button>
    </div>
  </nav>

  <div id="nav-mobile" class="nav-drawer sm:hidden" aria-hidden="true" inert>
    <div>
      <nav class="flex flex-col gap-0.5 px-4 pt-1 pb-3">
        <a
          href={inviteHref}
          class="ng-pressable mb-1 hidden min-h-11 items-center rounded-[6px] bg-primary px-3 text-sm font-medium text-primary-ink max-[359px]:flex"
        >
          Add to Discord
        </a>
        {
          links.map((l) => (
            <a
              href={l.href}
              class="flex min-h-11 items-center rounded-[6px] px-3 py-2.5 text-sm text-ink-muted transition-colors hover:bg-card hover:text-ink"
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<style>
  .nav-drawer {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    max-height: calc(100dvh - 7rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-top: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    opacity: 0.001;
    pointer-events: none;
    transform: translate3d(0, -10px, 0) scale(0.985);
    transform-origin: top center;
    box-shadow: 0 20px 30px hsl(20 20% 2% / 0.16);
    backface-visibility: hidden;
    contain: layout paint;
    will-change: transform, opacity;
    transition:
      transform 0.24s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.18s ease;
  }

  .nav-drawer.open {
    opacity: 1;
    pointer-events: auto;
    transform: translate3d(0, 0, 0) scale(1);
    transition-delay: 0s;
  }

  #nav-toggle .icon-menu,
  #nav-toggle .icon-close {
    grid-area: 1 / 1;
    transition:
      transform 0.2s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.14s ease;
    will-change: transform, opacity;
  }

  #nav-toggle .icon-close {
    opacity: 0;
    transform: rotate(-35deg) scale(0.78);
  }

  #nav-toggle.is-open .icon-menu {
    opacity: 0;
    transform: rotate(35deg) scale(0.78);
  }

  #nav-toggle.is-open .icon-close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  @media (min-width: 640px) {
    .nav-drawer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drawer {
      transform: none;
      transition: opacity 0.14s ease !important;
    }
    .nav-drawer.open {
      transition-delay: 0s !important;
    }
    #nav-toggle .icon-menu,
    #nav-toggle .icon-close {
      transform: none;
      transition: opacity 0.14s ease !important;
    }
  }
</style>

<script>
  function init() {
    const header = document.querySelector<HTMLElement>("[data-nav]");
    const toggle = document.getElementById("nav-toggle");
    const drawer = document.getElementById("nav-mobile");

    const setOpen = (open: boolean) => {
      drawer?.classList.toggle("open", open);
      drawer?.setAttribute("aria-hidden", String(!open));
      if (drawer) drawer.inert = !open;
      toggle?.setAttribute("aria-expanded", String(open));
      toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      toggle?.classList.toggle("is-open", open);
    };

    toggle?.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    drawer?.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => setOpen(false)),
    );
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener(
      "pointerdown",
      (event) => {
        if (
          toggle?.getAttribute("aria-expanded") === "true" &&
          event.target instanceof Node &&
          !header?.contains(event.target)
        ) {
          setOpen(false);
        }
      },
      { passive: true },
    );
    window.matchMedia("(min-width: 640px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });

    let statusWarmed = false;
    const warmStatus = () => {
      if (statusWarmed || window.location.pathname.startsWith("/status")) return;
      statusWarmed = true;
      window.__ngGetStatusSnapshot?.().catch(() => {
        statusWarmed = false;
      });
    };

    document.querySelectorAll<HTMLAnchorElement>('a[href="/status"]').forEach((link) => {
      link.addEventListener("pointerenter", warmStatus, { once: true, passive: true });
      link.addEventListener("focus", warmStatus, { once: true });
      link.addEventListener("pointerdown", warmStatus, { once: true, passive: true });
    });
  }

  init();
</script>

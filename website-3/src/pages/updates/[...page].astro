---
import type { Page, PaginateFunction } from "astro";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Pager from "../../components/Pager.astro";
import ReleaseAccordion from "../../components/ReleaseAccordion.astro";
import archive from "../../data/updates-archive.json";
import { currentRelease, releaseGroups, type ReleaseGroup } from "../../data/releases";
import type { Release } from "../../data/updates";

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  // Paginated by version rather than by update: a version is the unit people
  // browse, and splitting one across two pages would hide half its history
  // behind a page break. The size lives here because Astro hoists this
  // function into its own scope, where module constants are out of reach.
  return paginate(releaseGroups(archive as Release[]), { pageSize: 6 });
}

const { page } = Astro.props as { page: Page<ReleaseGroup> };
const totalUpdates = (archive as Release[]).length;
const release = currentRelease(archive as Release[]);
---

<Base
  title="Updates — NovaGuard"
  description="Every NovaGuard release, generated automatically from the deployed code."
>
  <Nav />
  <main>
    <section data-perf-section class="mx-auto max-w-4xl px-5 py-14 sm:px-6 sm:py-20">
      <p class="font-mono text-xs tracking-[0.14em] text-primary uppercase">Updates</p>
      <h1
        class="mt-4 max-w-2xl font-display text-[2.1rem] leading-[1.08] font-semibold tracking-[-0.02em] text-balance sm:text-5xl"
      >
        Every release, written by the code itself.
      </h1>
      <p class="mt-5 max-w-lg text-base leading-relaxed text-ink-muted">
        NovaGuard fingerprints its own source on every start. When something changed, it writes the
        release note below — no one edits this page by hand. Open a version to read everything that
        shipped in it.
      </p>

      {
        page.currentPage === 1 && (
          <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-4 border-t border-line pt-6">
            <div>
              <dt class="text-xs tracking-wider text-ink-faint uppercase">Latest release</dt>
              <dd
                aria-live="polite"
                class="mt-1 min-w-36 font-display text-2xl font-semibold tabular-nums text-ink"
              >
                <span data-current-release-version>{release.version}</span>
              </dd>
            </div>
            <div>
              <dt class="text-xs tracking-wider text-ink-faint uppercase">Versions</dt>
              <dd
                data-release-total-versions
                class="mt-1 font-display text-2xl font-semibold tabular-nums text-ink"
              >
                {page.total}
              </dd>
            </div>
            <div>
              <dt class="text-xs tracking-wider text-ink-faint uppercase">Updates</dt>
              <dd
                data-release-total-updates
                class="mt-1 font-display text-2xl font-semibold tabular-nums text-ink"
              >
                {totalUpdates}
              </dd>
            </div>
          </dl>
        )
      }

      <div class="mt-10" data-release-live={page.currentPage === 1 ? "" : undefined}>
        {
          page.data.length > 0 ? (
            <ReleaseAccordion groups={page.data} />
          ) : (
            <p class="py-8 text-sm text-ink-muted">
              No releases have been recorded yet. The next time NovaGuard starts with changed code,
              its release note will appear here.
            </p>
          )
        }
      </div>

      <Pager
        current={page.currentPage}
        total={page.lastPage}
        prevUrl={page.url.prev}
        nextUrl={page.url.next}
      />
    </section>
  </main>
  <Footer />
</Base>

<script>
  // Pulls in any release published since this page was built, so a changelog
  // that exists in Discord is not missing here until the next deploy.
  import "../../scripts/updates-live";
</script>

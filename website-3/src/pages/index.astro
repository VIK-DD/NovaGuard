---
import { PUBLIC_LAUNCH_PATH } from "../../launch-config.js";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta http-equiv="refresh" content={`0;url=${PUBLIC_LAUNCH_PATH}`} />
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={`https://novaguard.fun${PUBLIC_LAUNCH_PATH}`} />
    <title>Opening NovaGuard</title>
    <script is:inline define:vars={{ publicLaunchPath: PUBLIC_LAUNCH_PATH }}>
      window.location.replace(publicLaunchPath);
    </script>
  </head>
  <body>
    <p>Opening <a href={PUBLIC_LAUNCH_PATH}>NovaGuard</a>…</p>
  </body>
</html>

TOKEN=your_discord_bot_token_here

# Optional main server ID. Use /resync scope:server after a deploy for immediate command updates.
GUILD_ID=1454829495021338842

# GitHub integration
GITHUB_USERNAME=VIK-DD
GITHUB_PRIMARY_REPO=VIK-DD/NovaGuard
GITHUB_WATCH_REPOS=VIK-DD/NovaGuard
GITHUB_TOKEN=your_github_token_here
GITHUB_POLL_SECONDS=300

# Optional channel fallbacks for your main server
UPDATE_CHANNEL_ID=
GITHUB_EVENT_CHANNEL_ID=
ERROR_LOG_CHANNEL_ID=

# Optional extras
UPTIME_URL=
BOT_BRAND="Developed by VIK & CloudMedia"
STREAM_STATUSES=Watching late-night commits|I'll never forget that July|/help • the slash era|Shipping updates automatically
STREAM_STATUS_INTERVAL_SECONDS=15

# Which clock /voicehours counts months against. Leave empty to reuse
# BACKUP_TIMEZONE, which is what most setups want.
VOICE_TIMEZONE=

# Backup schedule and off-site copy
BACKUP_SCHEDULE=07:00,19:00
BACKUP_TIMEZONE=Europe/Chisinau
BACKUP_REMOTE_DEST=
BACKUP_REMOTE_FULL_PREFIX=full
BACKUP_REMOTE_GUILD_PREFIX=guilds
BACKUP_REMOTE_FULL_KEEP_DAYS=90
BACKUP_REMOTE_GUILD_KEEP_DAYS=60
BACKUP_REMOTE_RETENTION_ENABLED=true
BACKUP_REMOTE_TIMEOUT_SECONDS=300

# Optional AI support
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Web dashboard API (setup from the website)
# 1. Discord Developer Portal -> your app -> OAuth2 -> add redirect:
#    http://localhost:8300/api/auth/callback  (or your public URL)
# 2. Copy the Client ID + Client Secret below and set WEB_ENABLED=true
WEB_ENABLED=false
WEB_PORT=8300
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
WEB_OAUTH_REDIRECT=http://localhost:8300/api/auth/callback
# Where the browser lands after login (your dashboard page)
WEB_AFTER_LOGIN=/api/me

# Where Discord sends someone after they finish adding the bot to a server.
# Leave empty and the invite ends on Discord's own "Authorized" screen, which
# is the old behaviour. To send them back to your site instead, set this to
# the bot API's own /invite/complete URL AND add that exact URL to the
# application's OAuth2 -> Redirects list in the Discord Developer Portal --
# Discord rejects the whole invite link if it is not registered there.
# Example: https://api.novaguard.fun/api/v1/invite/complete
WEB_INVITE_REDIRECT=
# Where /invite/complete bounces to. Defaults to WEB_AFTER_LOGIN.
WEB_AFTER_INVITE=
# Allowed browser origins (comma-separated). Empty = same-origin only, never a
# wildcard. Example: https://novaguard.app,https://www.novaguard.app
WEB_CORS_ORIGIN=
# Set true when serving through HTTPS (Cloudflare Tunnel etc.)
WEB_COOKIE_SECURE=false
# Cookie SameSite: "Lax" if the dashboard is same-site as this API (including
# subdomains like app.novaguard.app + api.novaguard.app). Use "None" for a
# dashboard on a DIFFERENT domain (e.g. Vercel) — it forces HTTPS automatically.
WEB_COOKIE_SAMESITE=Lax
# Set true when behind a reverse proxy / Cloudflare Tunnel so rate limits and
# the audit trail see the real visitor IP (CF-Connecting-IP / X-Forwarded-For).
WEB_TRUST_PROXY=false
# Optional: key for encrypting OAuth tokens at rest. Defaults to the client
# secret; set a separate value to rotate independently. Requires `cryptography`.
WEB_TOKEN_KEY=

# Owner controls. The Discord application owner is always recognised; this
# only adds people, for a team or a break-glass account. Comma separated ids.
# The admin key itself is never stored here - generate it on the host with
# `venv/bin/python -m tools.admin_key` and keep it in a password manager.
BOT_OWNER_IDS=

# Music
# Backend: `yt-dlp` keeps the in-process player; `lavalink` uses a separate
# Lavalink v4 node via Wavelink.
MUSIC_BACKEND=yt-dlp
# How many servers may play audio at once. Raise only if the host has CPU to
# spare: SoundCloud needs transcoding, YouTube usually does not.
MUSIC_MAX_SESSIONS=3
# When true, /play may use SoundCloud as a rescue source if YouTube cannot
# resolve a playable stream. Default false keeps search YouTube-first and avoids
# fragile SoundCloud CDN/HLS links unless you explicitly want that fallback.
MUSIC_ENABLE_SOUNDCLOUD_FALLBACK=false
# Optional preference, not strict by default. 320 kbps is often unavailable on
# YouTube/SoundCloud, so NovaGuard falls back to the most stable audio stream.
MUSIC_MIN_AUDIO_BITRATE_KBPS=
# Optional. Set true only when you prefer "fail instead of lower bitrate".
MUSIC_STRICT_MIN_AUDIO_BITRATE=false
# Optional. Without these, Spotify track links still resolve through the
# public oEmbed endpoint; with them, playlists work too.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional. Use when YouTube asks yt-dlp to "Sign in to confirm you're not a
# bot". Export cookies in Netscape format and point this to that file.
MUSIC_YTDLP_COOKIES_FILE=
# Optional local/dev alternative, e.g. firefox or chrome:Default.
MUSIC_YTDLP_COOKIES_FROM_BROWSER=
# Optional. Use when YouTube logs "Signature solving failed" / "n challenge
# solving failed". Deno is preferred; include the absolute path if PM2 cannot
# see it in PATH. The Deno installer needs `unzip` or `7z` installed.
MUSIC_YTDLP_JS_RUNTIME=
# Optional escape hatch: ejs:github or ejs:npm if the bundled yt-dlp-ejs package
# is unavailable/outdated on the host.
MUSIC_YTDLP_REMOTE_COMPONENTS=
# Optional. Extra yt-dlp extractor args, split with `|`; useful for a YouTube
# PO Token provider when an Oracle/VPS IP is flagged by YouTube.
# Example:
# MUSIC_YTDLP_EXTRACTOR_ARGS=youtubepot-bgutilscript:server-home=/home/ubuntu/bgutil-ytdlp-pot-provider/server
MUSIC_YTDLP_EXTRACTOR_ARGS=
# Lavalink backend settings. Only used when MUSIC_BACKEND=lavalink.
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass
# ytmsearch usually returns better music matches than generic ytsearch.
MUSIC_LAVALINK_SEARCH_SOURCE=ytmsearch

.env
# The atomic writers create these beside their target; a crash between
# write and rename leaves one behind, and the ledger's carries deletion
# records. The exact names below do not cover them.
*.tmp
.*.tmp
.update_state.json
.github_state.json
.privacy_deletions.json
__pycache__/
.venv/
.venv-mac/
/venv/
.zap/reports/*
!.zap/reports/.gitkeep
node_modules/
/package-lock.json
/deploy/lavalink/Lavalink.jar
.claude/
data/
!website-3/src/data/
!website-3/src/data/**
backups/
# Private launch evidence can include provider screenshots, contracts and
# personal data. Use the public template, but never commit completed records.
/compliance-evidence/
.DS_Store
